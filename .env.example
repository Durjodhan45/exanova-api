NODE_ENV=development
PORT=3000
APP_NAME=ExaNova
FRONTEND_URL=https://exanova.vercel.app
DATABASE_URL=postgresql://user:password@ep-example-pooler.c-2.ap-southeast-1.aws.neon.tech/exanova-db?sslmode=require
DB_SSL=true
DB_POOL_MAX=5
JWT_ACCESS_SECRET=replace_with_secure_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_secure_secret
JWT_REFRESH_EXPIRES_IN=7d
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
UPLOAD_MAX_SIZE=10485760
SWAGGER_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@exanova.edu
ADMIN_INITIAL_PASSWORD=Admin@ExaNova2026!
